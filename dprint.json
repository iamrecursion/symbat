{
  "json": {
    "commentLine.forceSpaceAfterSlashes": true,
    "lineWidth": 120,
    "trailingCommas": "jsonc",
    "useTabs": false
  },
  "malva": {
    "indentWidth": 2,
    "printWidth": 120,
    "useTabs": false
  },
  "markdown": {
    "emphasisKind": "underscores",
    "lineWidth": 100,
    "newLineKind": "lf",
    "strongKind": "asterisks",
    "tags": {
      "markdown": "md"
    },
    "textWrap": "always"
  },
  "toml": {
    "cargo.applyConventions": true,
    "comment.forceLeadingSpace": true,
    "indentWidth": 2,
    "lineWidth": 120
  },
  "typescript": {
    "indentWidth": 2,
    "lineWidth": 120,
    "quoteStyle": "alwaysDouble",
    "semiColons": "always",
    "useTabs": false
  },
  "excludes": [
    "**/.git",
    "**/node_modules",
    "**/*-lock.json",
    "flake.lock",
    ".build",
    "main.js",
    "main.js.map",
    "src/wasm/pkg",
    ".github/ISSUE_TEMPLATE",
    ".github/pull_request_template.md"
  ],
  "plugins": [
    "https://plugins.dprint.dev/g-plane/malva-v0.16.0.wasm",
    "https://plugins.dprint.dev/json-0.21.3.wasm",
    "https://plugins.dprint.dev/markdown-0.21.1.wasm",
    "https://plugins.dprint.dev/toml-0.7.0.wasm",
    "https://plugins.dprint.dev/typescript-0.96.1.wasm"
  ]
}
